// Movie Battles II lightning materials, scoped to cg_lightningEnvironment 2.
// See credits/lightning_reference.txt for the original asset sources.
gfx/jof/lightning_reference/blueLine
{
	cull twosided
	{
		map gfx/jof/lightning_reference/blueline
		blendFunc GL_ONE GL_ONE
		rgbGen vertex
	}
}

gfx/jof/lightning_reference/lightningFlash
{
	cull twosided
	{
		map gfx/jof/lightning_reference/lightningflash
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen vertex
	}
}

gfx/jof/lightning_reference/sparkblue
{
	cull twosided
	{
		map gfx/jof/lightning_reference/sparkblue
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen vertex
	}
}
