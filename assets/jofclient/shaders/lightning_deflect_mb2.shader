// Isolated Movie Battles II materials for saber lightning deflection.
// See credits/lightning_deflect_mb2.txt.
gfx/jof/lightning_deflect_mb2/blueLine
{
	cull twosided
	{
		map gfx/jof/lightning_deflect_mb2/blueline
		blendFunc GL_ONE GL_ONE
		rgbGen vertex
	}
}

gfx/jof/lightning_deflect_mb2/lightningFlash
{
	cull twosided
	{
		map gfx/jof/lightning_deflect_mb2/lightningflash
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen vertex
	}
}
