# q_platform.h supplies ARCH_STRING on Windows and macOS. Standalone tests
# need the main build's target-architecture definition on Linux and BSD too.
function(ejk_test_platform target)
  if(WIN32 OR APPLE)
    return()
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" architecture)
  if(architecture MATCHES "^(arm64|aarch64)$")
    set(architecture "arm64")
  elseif(architecture MATCHES "^arm")
    set(architecture "arm")
  elseif(architecture MATCHES "^i.86$")
    set(architecture "i386")
  elseif(architecture MATCHES "^(x86.64|amd64)$")
    if(CMAKE_SIZEOF_VOID_P EQUAL 4)
      set(architecture "i386")
    else()
      set(architecture "x86_64")
    endif()
  elseif(architecture STREQUAL "powerpc")
    set(architecture "ppc")
  elseif(architecture STREQUAL "powerpc64")
    set(architecture "ppc64")
  elseif(architecture STREQUAL "")
    message(FATAL_ERROR "CMAKE_SYSTEM_PROCESSOR must identify the test target architecture")
  endif()
  target_compile_definitions(${target} PRIVATE ARCH_STRING="${architecture}")
endfunction()
