function(configure name expected_release expected_debug)
  set(output "${TEST_BINARY}/${name}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${output}"
    ${generator} -DROOT=${ROOT} -DCMAKE_BUILD_TYPE=Release ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
  file(WRITE "${TEST_BINARY}/${name}.log" "${log}\n${error}")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${name} configuration failed: ${log}\n${error}")
  endif()
  file(READ "${output}/properties.txt" properties)
  if(expected_release STREQUAL "AUTO")
    if(log MATCHES "Release IPO/LTO enabled")
      set(expected_release ON)
      # Single-config generators only initialize properties for their active
      # configuration. A Debug tree need not carry an inactive Release property.
      if(properties MATCHES "multi=OFF\n" AND properties MATCHES "configuration=Debug\n")
        set(expected_release OFF)
      endif()
    elseif(log MATCHES "Release IPO/LTO unavailable")
      set(expected_release OFF)
    else()
      message(FATAL_ERROR "${name}: missing IPO support result: ${log}")
    endif()
  endif()
  if(NOT properties MATCHES "release=${expected_release}\n" OR
     NOT properties MATCHES "debug=${expected_debug}\n")
    message(FATAL_ERROR "${name}: incorrect IPO properties: ${properties}")
  endif()
  if(NOT expected_debug AND NOT properties MATCHES "relwithdebinfo=OFF\n")
    message(FATAL_ERROR "${name}: automatic IPO leaked beyond Release: ${properties}")
  endif()
  if(name MATCHES "unsupported" AND NOT log MATCHES "Release IPO/LTO unavailable")
    message(FATAL_ERROR "${name}: missing fallback diagnostic")
  endif()
endfunction()
function(build name config expected_success)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_BINARY}/${name}" --config "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
  file(APPEND "${TEST_BINARY}/${name}.log" "\n${config} build:\n${log}\n${error}")
  if(expected_success AND NOT result EQUAL 0)
    message(FATAL_ERROR "${name} ${config} build failed: ${log}\n${error}")
  elseif(NOT expected_success AND result EQUAL 0)
    message(FATAL_ERROR "${name}: unrelated build error was hidden")
  endif()
endfunction()

