cmake_minimum_required(VERSION 3.16)
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
file(READ "${ROOT}/CMakeLists.txt" project_source)
string(FIND "${project_source}" "# Compiler settings" compiler_start)
string(SUBSTRING "${project_source}" ${compiler_start} -1 compiler_tail)
string(FIND "${compiler_tail}" "elseif ((" compiler_end)
if(compiler_start LESS 0 OR compiler_end LESS 0)
  message(FATAL_ERROR "Production MSVC configuration block not found")
endif()
string(SUBSTRING "${compiler_tail}" 0 ${compiler_end} compiler_source)
file(MAKE_DIRECTORY "${TEST_BINARY}/source")
file(WRITE "${TEST_BINARY}/source/compiler.cmake" "${compiler_source}\nendif()\n")
file(WRITE "${TEST_BINARY}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.16)
project(msvc_flag_fixture NONE)
# Exercise the actual MSVC configuration block on every host, without needing
# the MSVC compiler on non-Windows test runners.
set(MSVC TRUE)
list(APPEND CMAKE_MODULE_PATH "${ROOT}/CMakeModules")
set(CMAKE_C_FLAGS "/MD /D_C_ONLY" CACHE STRING "C flags")
set(CMAKE_CXX_FLAGS "/MD /D_CXX_ONLY" CACHE STRING "C++ flags")
set(CMAKE_C_FLAGS_DEBUG "/MDd /D_C_DEBUG_ONLY" CACHE STRING "C debug flags")
set(CMAKE_CXX_FLAGS_DEBUG "/MDd /D_CXX_DEBUG_ONLY" CACHE STRING "C++ debug flags")
set(CMAKE_C_FLAGS_RELEASE "/MD /O2 /D_C_RELEASE_ONLY" CACHE STRING "C release flags")
set(CMAKE_CXX_FLAGS_RELEASE "/MD /O2 /D_CXX_RELEASE_ONLY" CACHE STRING "C++ release flags")
include("${CMAKE_CURRENT_SOURCE_DIR}/compiler.cmake")
foreach(language C CXX)
  foreach(config "" _DEBUG _RELEASE _RELWITHDEBINFO)
    set(variable "CMAKE_${language}_FLAGS${config}")
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/flags.txt" "${variable}=${${variable}}\n")
  endforeach()
endforeach()
if(NOT CMAKE_C_FLAGS MATCHES "/D_C_ONLY" OR CMAKE_C_FLAGS MATCHES "/D_CXX_ONLY" OR
   NOT CMAKE_CXX_FLAGS MATCHES "/D_CXX_ONLY" OR CMAKE_CXX_FLAGS MATCHES "/D_C_ONLY")
  message(FATAL_ERROR "C/C++ toolchain flags were overwritten")
endif()
if(NOT CMAKE_C_FLAGS_DEBUG MATCHES "/D_C_DEBUG_ONLY" OR
   NOT CMAKE_CXX_FLAGS_DEBUG MATCHES "/D_CXX_DEBUG_ONLY")
  message(FATAL_ERROR "Language-specific debug flags were overwritten")
endif()
if(NOT CMAKE_C_FLAGS_RELEASE MATCHES "/D_C_RELEASE_ONLY" OR
   NOT CMAKE_CXX_FLAGS_RELEASE MATCHES "/D_CXX_RELEASE_ONLY")
  message(FATAL_ERROR "Language-specific release flags were overwritten")
endif()
get_property(cached_c CACHE CMAKE_C_FLAGS PROPERTY VALUE)
get_property(cached_cxx CACHE CMAKE_CXX_FLAGS PROPERTY VALUE)
if(NOT cached_c STREQUAL "/MD /D_C_ONLY" OR NOT cached_cxx STREQUAL "/MD /D_CXX_ONLY")
  message(FATAL_ERROR "Augmented flags leaked into cache")
endif()
if(MSVC_RUNTIME STREQUAL "static")
  if(NOT CMAKE_C_FLAGS MATCHES "/MT " OR NOT CMAKE_CXX_FLAGS_DEBUG MATCHES "/MTd ")
    message(FATAL_ERROR "Static runtime selection failed")
  endif()
else()
  if(NOT CMAKE_C_FLAGS MATCHES "/MD " OR NOT CMAKE_CXX_FLAGS_DEBUG MATCHES "/MDd ")
    message(FATAL_ERROR "Dynamic runtime selection failed")
  endif()
endif()
]=])
foreach(runtime dynamic static)
  set(output "${TEST_BINARY}/${runtime}")
  foreach(pass 1 2)
    file(WRITE "${output}/flags.txt" "")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_BINARY}/source" -B "${output}"
      -DROOT=${ROOT} -DMSVC_RUNTIME=${runtime} RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Configuration failed: ${log}\n${error}")
    endif()
    file(READ "${output}/flags.txt" flags)
    if(pass EQUAL 1)
      set(first "${flags}")
    elseif(NOT flags STREQUAL first)
      message(FATAL_ERROR "Flags changed after reconfigure (${runtime}):\n${first}\n${flags}")
    endif()
  endforeach()
endforeach()
message(STATUS "MSVC flags retain language settings and remain stable across reconfiguration")
