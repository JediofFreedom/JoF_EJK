include("${ROOT}/lib/zlib/BuildZlibNG.cmake")
set(CMAKE_C_COMPILER_ID GNU)
set(MSVC FALSE)
set(CMAKE_VERSION 3.10.3)
ejk_zlib_ng_support(supported reason)
if(supported OR NOT reason MATCHES "3.14")
  message(FATAL_ERROR "CMake 3.10 must retain the classic backend: ${reason}")
endif()
set(CMAKE_VERSION 3.14.0)
ejk_zlib_ng_support(supported reason)
if(NOT supported)
  message(FATAL_ERROR "Supported CMake/compiler unexpectedly rejected: ${reason}")
endif()
set(CMAKE_C_COMPILER_ID UnknownVendor)
ejk_zlib_ng_support(supported reason)
if(supported OR NOT reason MATCHES "UnknownVendor")
  message(FATAL_ERROR "Unsupported compiler must fall back explicitly: ${reason}")
endif()
set(MSVC TRUE)
set(CMAKE_C_COMPILER_ID MSVC)
set(MSVC_VERSION 1700)
ejk_zlib_ng_support(supported reason)
if(supported OR NOT reason MATCHES "2013")
  message(FATAL_ERROR "Unsupported MSVC must retain classic zlib: ${reason}")
endif()
set(MSVC_VERSION 1800)
ejk_zlib_ng_support(supported reason)
if(NOT supported)
  message(FATAL_ERROR "Supported MSVC unexpectedly rejected: ${reason}")
endif()
set(MSVC FALSE)
set(CMAKE_C_COMPILER_ID AppleClang)
set(APPLE TRUE)
foreach(architectures "arm64;x86_64" "x86_64;arm64")
  set(CMAKE_OSX_ARCHITECTURES "${architectures}")
  ejk_zlib_ng_support(supported reason)
  if(supported OR NOT reason MATCHES "universal")
    message(FATAL_ERROR "Mixed macOS targets must use classic zlib: ${reason}")
  endif()
endforeach()
foreach(architectures "arm64" "x86_64" "arm64;arm64" "")
  set(CMAKE_OSX_ARCHITECTURES "${architectures}")
  ejk_zlib_ng_support(supported reason)
  if(NOT supported)
    message(FATAL_ERROR "Single/default macOS target unexpectedly rejected: ${reason}")
  endif()
endforeach()
set(APPLE FALSE)
set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64")
ejk_zlib_ng_support(supported reason)
if(NOT supported)
  message(FATAL_ERROR "macOS-only architecture restriction affected another platform: ${reason}")
endif()
