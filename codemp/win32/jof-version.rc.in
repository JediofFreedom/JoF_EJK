#include <winver.h>

1 VERSIONINFO
 FILEVERSION @JOF_RESOURCE_VERSION@
 PRODUCTVERSION @JOF_RESOURCE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @JOF_RESOURCE_FILE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JoF contributors\0"
            VALUE "FileDescription", "JoF EternalJK Client component\0"
            VALUE "FileVersion", "@JOF_WINDOWS_FILE_VERSION@\0"
            VALUE "InternalName", "@JOF_RESOURCE_FILENAME@\0"
            VALUE "OriginalFilename", "@JOF_RESOURCE_FILENAME@\0"
            VALUE "ProductName", "JoF EternalJK\0"
            VALUE "ProductVersion", "@JOF_WINDOWS_FILE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
